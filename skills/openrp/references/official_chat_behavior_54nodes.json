        },
        "data": {
          "comment": "",
          "variables": [
            {
              "key": {
                "$template": "remainingTokenBudget"
              },
              "value": {
                "$expression": "(chatMessage.modelSettings?.inputTokens ?? 2000) - pruneSystemPrompt.tokenCount"
              }
            }
          ]
        },
        "lcaNodeId": null
      },
      {
        "id": "getChatHistory",
        "type": "storage/get_chat_messages",
        "position": {
          "x": 1600,
          "y": 200
        },
        "data": {
          "limit": 50,
          "chatId": {
            "$expression": "chat.id"
          },
          "expand": [
            "attachments"
          ],
          "comment": "Fetch history in batches of 50 to fill token budget.",
          "endingBefore": {
            "$expression": ""
          },
          "startingAfter": {
            "$expression": "$variables.chatHistoryCursor"
          }
        },
        "lcaNodeId": null
      },
      {
        "id": "repeatUntilChatHistoryProcessed",
        "type": "control_flow/repeat_until",
        "position": {
          "x": 1800,
          "y": 200
        },
        "data": {
          "comment": "Here we check whether messageBatchCount is > 0 because we will repeatedly lower this (until it becomes 0) when we attempt to squeeze in messages into our chat history context.",
          "expression": {
            "$expression": "$variables.messageBatchCount > 0 && $variables.nextProcessingIndex < getChatHistory.data.length"
          },
          "checkConditionBeforeRunning": true
        },
        "lcaNodeId": null
      },
      {
        "id": "countTokens",
        "type": "ai/count_tokens",
        "position": {
          "x": 1600,
          "y": 100
        },
        "data": {
          "text": {
            "$template": "{{$variables.processingChatMessages.map(message => message.content).join(\"\\n\")}}"
          },
          "comment": "Count the text portion of the message. ",
          "tokenizer": {
            "$template": "{{getDefaultModel.tokenizer}}"
          }
        },
        "lcaNodeId": null
      },
      {
        "id": "calculateTokenCost",
        "type": "storage/set_variable",
        "position": {
          "x": 1700,
          "y": 100
        },
        "data": {
          "comment": "We calculate the token cost for the messages. Here we look at the length of attachments from all the messages, which we assume are photos for now, and estimate that they take up 250 tokens each.",
          "variables": [
            {
              "key": {
                "$template": "messagesTokenCost"
              },
              "value": {
                "$expression": "countTokens.count + $variables.processingChatMessages.map(message => message.attachments?.data?.length || 0).reduce((total, current) => total + current, 0) * 250"
              }
            }
          ]
        },
        "lcaNodeId": null
      },
