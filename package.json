{
  "name": "openrp-toolkit",
  "version": "3.0.0",
  "description": "Model Context Protocol (MCP) Server and AI Agent Skill Suite for OpenRP.ai",
  "main": "bin/cli.js",
  "bin": {
    "openrp-toolkit": "./bin/cli.js",
    "openrp": "./bin/cli.js"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "serve": "node ./bin/cli.js serve",
