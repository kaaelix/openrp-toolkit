      {
        "id": "setProcessingChatMessages",
        "type": "storage/set_variable",
        "position": {
          "x": 1500,
          "y": 100
        },
        "data": {
          "comment": "Grab the messages to process. Chat history is fetched in descending order (latest messages first).",
          "variables": [
            {
              "key": {
                "$template": "processingChatMessages"
              },
              "value": {
                "$expression": "getChatHistory.data.slice($variables.nextProcessingIndex, $variables.nextProcessingIndex + $variables.messageBatchCount)"
              }
            }
          ]
        },
        "lcaNodeId": null
      },
      {
        "id": "setMessageBatchCount",
        "type": "storage/set_variable",
        "position": {
          "x": 1900,
          "y": 100
        },
        "data": {
          "comment": "If we went over the limit, attempt to lower message batch count.",
          "variables": [
            {
              "key": {
                "$template": "messageBatchCount"
              },
              "value": {
                "$expression": "Math.floor($variables.messageBatchCount / 2)"
              }
            }
          ]
        },
        "lcaNodeId": null
      },
      {
        "id": "setNextProcessingIndex",
        "type": "storage/set_variable",
        "position": {
