      {
        "id": "repeatUntilTokenBudgetFilled",
        "type": "control_flow/repeat_until",
        "position": {
          "x": 1800,
          "y": 300
        },
        "data": {
          "comment": "Fill the remaining 40% of token budget with chat history. Keep fetching until we run out of token budget or there are no more history to fetch.\n\nInstead of checking token budget directly, we check whether messageBatchCount is > 0 because we will repeatedly lower this (until it becomes 0) when we attempt to squeeze in messages into our chat history context.",
          "expression": {
            "$expression": "$variables.messageBatchCount > 0 && getChatHistory?.hasMore"
          },
          "checkConditionBeforeRunning": false
        },
        "lcaNodeId": null
      },
      {
        "id": "setRemainingTokenBudget",
